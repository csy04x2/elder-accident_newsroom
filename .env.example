# 실제 비밀키를 여기에 넣지 마세요. 복사한 .env만 로컬에서 수정합니다.
APP_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# MySQL 8.x, SQLAlchemy + PyMySQL 접속 문자열
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/elder_accident_newsroom?charset=utf8mb4
# 기존 elder_accident/data/processed의 로컬 경로 (상대/절대 경로 가능)
DATA_DIR=data/processed

# 편집장 인증 구현 시 사용 (평문 암호 저장 금지)
EDITOR_AUTH_SECRET=
EDITOR_PASSWORD_HASH=

# 외부 연동 채택 시 선택적으로 입력
NEWS_SEARCH_API_KEY=
SEOUL_OPEN_API_KEY=
# 추후 임베딩 검색이 필요해지는 경우에만 사용
OPENAI_EMBEDDING_MODEL=
